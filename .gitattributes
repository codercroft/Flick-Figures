# Normalize line endings: store LF in the repo, let Git convert on checkout
* text=auto eol=lf

# Binary assets (never touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.glb binary
*.res binary
*.scn binary
